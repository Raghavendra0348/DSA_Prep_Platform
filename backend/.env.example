# Environment Variables — DSA Prep Platform Backend
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# ── Database ──────────────────────────────────────────────────────────────────
# Development (local PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/dsa_db"

# Production (Aiven — just swap this URL, zero code changes needed)
# DATABASE_URL="postgresql://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Google OAuth Client ID (from Google Cloud Console → APIs & Services → Credentials)
# Guide: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# Access token secret — used to sign 7-day JWTs
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your_super_secret_key_change_this_in_production"

# Refresh token secret — used to sign 30-day refresh JWTs
# Should be different from JWT_SECRET
JWT_REFRESH_SECRET="your_refresh_secret_change_this_in_production"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development   # development | production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Frontend origin allowed to make requests
CORS_ORIGIN=http://localhost:5173
