# Environment Variables — DSA Prep Platform Backend
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# ── Database ──────────────────────────────────────────────────────────────────
# Development (local PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/dsa_db"

# Production runtime: Neon pooled endpoint (keep credentials URL encoded).
# DATABASE_URL="postgresql://ROLE:PASSWORD@ep-NAME-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
# Prisma CLI and CSV imports: direct endpoint; falls back to DATABASE_URL locally.
# DIRECT_URL="postgresql://ROLE:PASSWORD@ep-NAME.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
# DATABASE_URL_UNPOOLED (the Neon CLI name) is also accepted after DIRECT_URL.
# After `neon deploy` at repository root, run `npm run db:neon -- sync-env`
# here to stage URLs without switching the active Aiven database.
# Optional CA file for Aiven's private CA during transition. Neon uses public CAs.
# DB_SSL_CA_PATH="C:/secure/aiven-ca.pem"
# Temporary migration-only secrets (do not change DATABASE_URL before validation).
# SOURCE_DATABASE_URL="postgresql://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=verify-full&sslrootcert=C%3A%2Fsecure%2Faiven-ca.pem"
# NEON_DATABASE_URL="postgresql://ROLE:PASSWORD@ep-NAME-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
# NEON_DIRECT_URL="postgresql://ROLE:PASSWORD@ep-NAME.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# Maximum connections per backend process. Keep the combined total across all
# replicas, rolling deploys and scripts below your database's connection limit.
DB_POOL_MAX=5
# Queries are bounded to 15s on PostgreSQL (20s client timeout).
# /health checks the DB (503 on failure); /health/live checks only the HTTP app.
# A powered-off Aiven service must be started in Aiven; requests cannot wake it.

# ── Auth ──────────────────────────────────────────────────────────────────────
# Google OAuth Client ID (from Google Cloud Console → APIs & Services → Credentials)
# Guide: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# Access token secret — used to sign 7-day JWTs
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your_super_secret_key_change_this_in_production"

# Refresh token secret — used to sign 30-day refresh JWTs
# Should be different from JWT_SECRET
JWT_REFRESH_SECRET="your_refresh_secret_change_this_in_production"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development   # development | production
MAINTENANCE_MODE=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Frontend origin allowed to make requests
CORS_ORIGIN=http://localhost:5173

# ── Email Service (Resend — Recommended for Production on Render) ───────────────
# Get your free API key at https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key_here"
# Default testing address (sends to the Resend account owner):
# Once you add and verify your custom domain on Resend, change this to your domain:
RESEND_FROM="DSA Prep <onboarding@resend.dev>"

# ── Legacy Email / SMTP Fallback ───────────────────────────────────────────────
# Fallback if RESEND_API_KEY is not set
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@gmail.com"
# 16-character Google App Password: https://myaccount.google.com/apppasswords
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="\"DSA Prep\" <your-email@gmail.com>"
