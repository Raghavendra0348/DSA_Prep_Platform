// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        Int               @id @default(autoincrement())
  name      String            @unique
  slug      String            @unique
  questions CompanyQuestion[]
}

model Question {
  id         Int               @id @default(autoincrement())
  slug       String            @unique
  title      String
  difficulty String
  link       String
  topics     String[]
  companies  CompanyQuestion[]
  progress   Progress[]
  bookmarks  Bookmark[]

  @@index([difficulty])
  @@index([title])
}

model CompanyQuestion {
  companyId      Int
  questionId     Int
  period         String
  frequency      Float
  acceptanceRate Float

  company  Company  @relation(fields: [companyId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@id([companyId, questionId, period])
  // Covering indexes: WHERE companyId+period is satisfied AND ORDER BY is free
  // (Postgres can walk the index in order without a separate sort step)
  @@index([companyId, period, frequency(sort: Desc)])
  @@index([companyId, period, acceptanceRate(sort: Desc)])
  @@index([questionId])
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String
  password     String?                          // null for Google-only users
  googleId     String?    @unique               // Google 'sub' claim (unique user ID)
  authProvider String     @default("email")     // "email" | "google" | "both"
  avatar       String?
  createdAt    DateTime   @default(now())
  progress      Progress[]
  bookmarks     Bookmark[]
  refreshTokens RefreshToken[]
}

model Progress {
  userId     String
  questionId Int
  status     String   // "solved" | "attempted" | "not-started"
  notes      String?  // personal notes per problem (M3)
  solvedAt   DateTime? // timestamp of first solve — set once when status → "solved" (M3)
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@id([userId, questionId])
  // Speeds up batch progress lookup: WHERE userId=X AND questionId IN (...)
  @@index([userId, questionId])
}

model Bookmark {
  userId     String
  questionId Int
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@id([userId, questionId])
  // Speeds up batch bookmark lookup: WHERE userId=X AND questionId IN (...)
  @@index([userId, questionId])
}

// Stores refresh tokens for server-side logout + token rotation.
// When user logs out, their token is deleted → /refresh fails → they must log in again.
model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Stores 6-digit OTP verification codes for email signup.
// Auto-expires after 10 minutes.
model VerificationCode {
  id        Int      @id @default(autoincrement())
  email     String
  code      String   // Hashed or encrypted OTP string
  attempts  Int      @default(0) // Brute-force protection: max 5 attempts
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}


